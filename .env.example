# Copy to .env locally. Never share the completed file.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_USER_IDS=YOUR_TELEGRAM_USER_ID
# Empty chat list permits only private chats for allowed users.
TELEGRAM_ALLOWED_CHAT_IDS=
DIALOG_HISTORY_MESSAGES=20
DIALOG_SESSION_TIMEOUT=3600
DIALOG_MAX_SESSIONS=256

LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
SEARCH_TOP_K=5
HYBRID_SEARCH=true
CACHE_ENABLED=true

# Optional official SDK. TLS is always enabled in ai_processor/providers.py.
GIGACHAT_MODEL=GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_BUNDLE_FILE=
# SOURCE_DOCX / GIGACHAT_BASE_URL / CHROMA_* are not read by the active atlas settings.
# See README for source paths and the unresolved GigaChat endpoint discrepancy.
